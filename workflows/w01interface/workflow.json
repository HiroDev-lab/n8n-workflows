      "id": "a70bac8d-64ef-45cf-b4f1-be7d534a321d",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "// 1. Acesso direto e rápido ao primeiro item\nconst payload = $input.first().json.payload || [];\nconst total = payload.length;\n\n// 2. Pré-alocação do array (evita que o JS tenha que redimensionar o array na memória várias vezes)\nconst caixasFiltradas = new Array(total);\n\n// 3. Loop 'for' clássico: é o método mais veloz no motor V8 (Node.js)\nfor (let i = 0; i < total; i++) {\n  const caixa = payload[i];\n  caixasFiltradas[i] = {\n    id: caixa.id,\n    name: caixa.name\n  };\n}\n\n// 4. Retorno mantendo a estrutura original\nreturn {\n  lista_caixas: caixasFiltradas\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        544
      ],
      "id": "7572a4f9-0112-4b9e-84c8-f42c977dfeed",
      "name": "Filter - Inbox"
    },
    {
      "parameters": {
        "jsCode": "// Pega os dados do nó anterior\nconst dadosEntrada = $input.all()[0].json;\nconst listaEtiquetas = dadosEntrada.payload;\n\n// Filtra apenas o ID e o Nome (que nessa rota se chama 'title')\nconst etiquetasFiltradas = listaEtiquetas.map(etiqueta => {\n  return {\n    id: etiqueta.id,\n    name: etiqueta.title // Já renomeei para 'name' para ficar padronizado no seu fluxo\n  };\n});\n\n// Retorna um único objeto, mantendo a lista agregada dentro da propriedade \"lista_etiquetas\"\nreturn {\n  lista_etiquetas: etiquetasFiltradas\n};"
      },

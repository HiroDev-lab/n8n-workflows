    {
      "parameters": {
        "url": "https://chat.maxxitele.com.br/api/v1/accounts/1/conversations",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "open"
            },
            {
              "name": "per_page",
              "value": "100"
            },
            {
              "name": "page",
              "value": "={{ $json.page }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "YOUR_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "id": "aaa00001-0000-0000-0000-000000000004",
      "name": "Buscar Conversas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        320,
        224
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "function norm(s) {\n  return s.toString().toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").trim();\n}\n\nconst protectedNorm = [\"conta_em_analise\", \"pendencia\", \"conta_aberta\", \"mais_tarde\", \"maquininha\"];\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const corpo = item.json;\n  const listaDeConversas = Array.isArray(corpo?.data?.payload) ? corpo.data.payload : [];\n\n  for (const conv of listaDeConversas) {\n    const assigneeId = conv.meta?.assignee?.id;\n    if (assigneeId === 1) continue;\n\n    const convLabels = (conv.labels || []).map(norm);\n    const hasProtected = protectedNorm.some(pl => convLabels.includes(pl));\n\n    if (!hasProtected) {\n      const newLabels = [...new Set([...conv.labels, \"robo\"])];\n      resultados.push({ json: { conversation_id: conv.id, labels: newLabels } });\n    }\n  }\n}\n\nreturn resultados;"
      },
      "id": "aaa00001-0000-0000-0000-000000000002",
      "name": "Filtrar Conversas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://chat.maxxitele.com.br/api/v1/accounts/1/conversations/{{ $json.conversation_id }}/labels",

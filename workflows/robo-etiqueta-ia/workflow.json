      "id": "8787cc5b-abb7-4e78-a196-3c4451b9442f",
      "name": "Manter Etiquetas + IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        48,
        16
      ],
      "retryOnFail": true,
      "maxTries": 5
    },
    {
      "parameters": {
        "jsCode": "const idsPermitidos = new Set([22, 31, 29, 28, 19, 33, 30].map(String));\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const corpo = item.json;\n\n  const listaDeConversas = Array.isArray(corpo?.data?.payload)\n    ? corpo.data.payload\n    : [];\n\n  for (const conv of listaDeConversas) {\n    const assigneeId = conv?.meta?.assignee?.id;\n\n    if (!assigneeId) continue;\n\n    if (idsPermitidos.has(String(assigneeId))) {\n      resultados.push({ json: conv });\n    }\n  }\n}\n\nreturn resultados;"
      },

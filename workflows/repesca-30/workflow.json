    {
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn $items()\n  .map(i => i.json)\n  .filter(i => i && i.data && i.data.wuid) // remove vazios\n  .filter(i => {\n    // 🔥 MESMA LÓGICA, só mudamos o ID\n    let id = String(i.data.wuid)\n      .replace(\"@s.whatsapp.net\", \"\")\n      .replace(\"@c.us\", \"\")\n      .replace(/\\D/g, \"\");\n\n    // remove o 9 extra (BR)\n    if (id.startsWith(\"55\") && id.length === 13 && id[4] === \"9\") {\n      id = id.slice(0, 4) + id.slice(5);\n    }\n\n    if (seen.has(id)) return false;\n    seen.add(id);\n    return true;\n  })\n  .map(i => {\n    const data = i.data;\n\n    const originalRaw = (i.original_phone ?? data.original_phone ?? null);\n    const original_phone =\n      originalRaw === null || originalRaw === undefined || String(originalRaw).trim() === \"\"\n        ? null\n        : String(originalRaw).replace(/\\D/g, \"\");\n\n    const rowRaw = (i.row_number ?? data.row_number ?? null);\n    const row_number =\n      rowRaw === null || rowRaw === undefined || String(rowRaw).trim() === \"\"\n        ? null\n        : Number(rowRaw);\n\n    const razao = i.razao ?? data.razao ?? \"\";\n    const cnpj = i.cnpj ?? data.cnpj ?? \"\";\n    const observacao = i.observacao ?? data.observacao ?? \"\";\n\n    return {\n      json: {\n        wuid: data.wuid,\n        numberExists: data.numberExists,\n\n        razao,\n        cnpj: String(cnpj),\n        observacao,\n\n        ...(data.picture ? { picture: data.picture } : {}),\n\n        ...(data.status && data.status.status && String(data.status.status).trim()\n          ? { status: String(data.status.status).trim() }\n          : {}),\n\n        ...(data.isBusiness !== undefined\n          ? { isBusiness: data.isBusiness }\n          : {}),\n\n        ...(original_phone ? { original_phone } : {}),\n        ...(row_number !== null && !Number.isNaN(row_number) ? { row_number } : {})\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst messageType = body.message_type;\n\nif (messageType !== \"incoming\") return [];\n\nconst rawContent = body.content || (body.messages?.[0]?.content) || \"\";\nconst conversationId = body.conversation?.id || body.conversation_id;\n\nconst exactKeywords = [\"encerrar\", \"sair\", \"bloquear\"];\nconst partialKeywords = [\n  \"encerrar atendimento\",\n  \"n\\u00e3o solicitei contato\"\n];\n\nconst sanitized = rawContent\n  .toString()\n  .toLowerCase()\n  .normalize(\"NFC\")\n  .replace(/\\u2060/g, \"\")\n  .trim();\n\nconst isExact = exactKeywords.some(opt => sanitized === opt);\nconst isPartial = partialKeywords.some(opt => sanitized.includes(opt));\n\nif (!isExact && !isPartial) return [];\n\nreturn [\n  {\n    json: {\n      conversation_id: conversationId\n    }\n  }\n];"
      },
      "id": "f04a778d-bb19-4f37-8673-354cfa8c3c99",
      "name": "Filtrar Palavras-Chave",

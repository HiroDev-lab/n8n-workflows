      "name": "Get - Inbox"
    },
    {
      "parameters": {
        "jsCode": "const result = [];\n\nfor (const item of $input.all()) {\n  const payload = item.json.payload;\n\n  // Verifica se a propriedade message_templates existe e é um array\n  if (payload && Array.isArray(payload.message_templates)) {\n    \n    // Filtra para manter apenas os templates aprovados\n    const approvedTemplates = payload.message_templates.filter(\n      template => template.status === \"APPROVED\"\n    );\n\n    // Se houver 1 ou mais templates aprovados, atualiza a lista e mantém o item\n    if (approvedTemplates.length > 0) {\n      payload.message_templates = approvedTemplates;\n      result.push(item);\n    }\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -16
      ],

    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst output = [];\n\nfunction normalizeRazao(value) {\n  return String(value ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toUpperCase();\n}\n\nfunction normalizePhone(value) {\n  const raw = String(value ?? '').trim();\n\n  if (!raw || raw.toLowerCase() === 'null' || raw.toLowerCase() === 'undefined') {\n    return '';\n  }\n\n  return raw.replace(/\\D/g, '');\n}\n\nfunction processRecord(record) {\n  if (!record || typeof record !== 'object' || Array.isArray(record)) return;\n  if (Object.keys(record).length === 0) return;\n  if (record.error || record.errorMessage) return;\n\n  const razao = normalizeRazao(record['RAZÃO ']);\n  const telefone = normalizePhone(record.TELEFONE);\n\n  if (!razao) return;\n  if (!telefone || telefone.length < 10) return;\n\n  if (!seen.has(razao)) {\n    seen.add(razao);\n    output.push({ json: record });\n  }\n}\n\nfor (const item of $input.all()) {\n  try {\n    const data = item?.json;\n\n    if (Array.isArray(data)) {\n      for (const record of data) {\n        processRecord(record);\n      }\n    } else {\n      processRecord(data);\n    }\n  } catch (e) {}\n}\n\nreturn output;"
      },

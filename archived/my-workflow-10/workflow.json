    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Pega os dados dos nodes Form e Form1\nconst formItems = $items(\"Form\", 0) || [];\nconst form1Items = $items(\"Form1\", 0) || [];\n\n// Junta todos os campos de um node em um único objeto\nfunction juntarDadosNode(nodeItems, prefixo) {\n  const resultado = {};\n\n  for (const item of nodeItems) {\n    if (item.json && typeof item.json === \"object\") {\n      for (const [chave, valor] of Object.entries(item.json)) {\n        resultado[`${prefixo}${chave}`] = valor;\n      }\n    }\n  }\n\n  return resultado;\n}\n\nconst formData = juntarDadosNode(formItems, \"Form_\");\nconst form1Data = juntarDadosNode(form1Items, \"Form1_\");\n\nfunction gerarVariacoes(numero) {\n  let n = String(numero || \"\").replace(/\\D/g, \"\");\n\n  let prefixo = \"\";\n  let ddd = \"\";\n  let local = \"\";\n\n  // Detecta se tem 55 na frente\n  if (n.startsWith(\"55\") && n.length >= 12) {\n    prefixo = \"55\";\n    ddd = n.slice(2, 4);\n    local = n.slice(4);\n  } else {\n    ddd = n.slice(0, 2);\n    local = n.slice(2);\n  }\n\n  let com9 = \"\";\n  let sem9 = \"\";\n\n  // Já tem 9\n  if (local.length === 9 && local.startsWith(\"9\")) {\n    com9 = local;\n    sem9 = local.slice(1);\n  }\n  // Não tem 9\n  else if (local.length === 8) {\n    sem9 = local;\n    com9 = \"9\" + local;\n  }\n  // Caso estranho, tenta normalizar\n  else {\n    local = local.replace(/^9+/, \"9\");\n\n    if (local.startsWith(\"9\")) {\n      com9 = local;\n      sem9 = local.slice(1);\n    } else {\n      sem9 = local;\n      com9 = \"9\" + local;\n    }\n  }\n\n  const resultado = [\n    prefixo + ddd + com9,\n    prefixo + ddd + sem9\n  ];\n\n  return [...new Set(resultado)].filter(Boolean);\n}\n\nconst output = [];\n\nfor (const item of items) {\n  const telefone = item.json[\"TELEFONE\"];\n  const variacoes = gerarVariacoes(telefone);\n\n  for (const num of variacoes) {\n    output.push({\n      json: {\n        ...item.json,\n        ...formData,\n        ...form1Data,\n        TELEFONE: num\n      }\n    });\n  }\n}\n\nreturn output;"
      },

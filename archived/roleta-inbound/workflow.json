      "parameters": {
        "jsCode": "const listaAgentes = $items(\"Get many rows\", 0).map(row => row.json);\n\nlet idx = $items(\"Indice\", 0)[0].json.current_index;\nidx = (idx === null || idx === undefined) ? 0 : parseInt(idx, 10);\n\nconst agenteAtual = listaAgentes[idx % listaAgentes.length];\nconst proximoIdx = (idx + 1) % listaAgentes.length;\n\nconst webhookData = $items(\"Webhook1\", 0)[0].json;\n\nreturn [{\n  json: {\n    agent_id: agenteAtual.agent_id,\n    conversation_id: webhookData.body.id,\n    agent_name: agenteAtual.agent_name,\n    proximoIdx: proximoIdx\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "const sql = `\n--(3, 'Isabela Pereira', 1),\n--(8, 'Mariane oliveira', 1),\n--(10, 'Jose Antonio', 2),\n(19, 'Caio', 1),\n--(20, 'Steicy', 4),\n--(22, 'Ellen', 4),\n--(24, 'Carolina', 6),\n--(29, 'Ana', 1),\n--(28, 'PEDRO MARINHO', 1),\n--(30, 'Kaled', 2);\n`\n\nconst ativos = sql\n  .split(\"\\n\")\n  .map(l => l.trim())\n  .filter(l => l.startsWith(\"(\") && !l.startsWith(\"--\"));\n\nconst re = /\\(\\s*(-?\\d+)\\s*,\\s*'([^']*)'\\s*,\\s*(-?\\d+)\\s*\\)/;\n\nconst agentes = ativos.map(l => {\n  const m = l.match(re);\n  if (!m) return null;\n  return {\n    agent_id: Number(m[1]),\n    agent_name: m[2],\n    position: Number(m[3]),\n  };\n}).filter(Boolean);\n\n// retorna TODOS\nreturn agentes.map(a => ({\n  json: a\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -176
      ],

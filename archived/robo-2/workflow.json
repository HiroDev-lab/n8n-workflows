    {
      "parameters": {
        "jsCode": "// Junta todas as conversas de TODOS os items\nconst todasConversas = [];\n\nfor (const item of items) {\n  if (item.json?.data?.payload) {\n    todasConversas.push(...item.json.data.payload);\n  }\n}\n\n// Filtra quem tem label robo\nconst resultado = todasConversas.filter(conv =>\n  Array.isArray(conv.labels) &&\n  conv.labels.some(l => String(l).toLowerCase() === \"robo2\")\n);\n\n// Retorna cada conversa como um item separado\nreturn resultado.map(conv => ({\n  json: conv\n}));"
      },
